{
  "schema_version": 1,
  "family": "fastconformer_ctc",
  "display_name": "FastConformer CTC ASR",
  "description": "Standard NeMo FastConformer encoder (dw_striding subsampling, rel_pos attention) with a plain CTC decoder head, for EncDecCTCModelBPE .nemo checkpoints such as hishab/titu_stt_bn_fastconformer.",
  "category": "asr",
  "status": "experimental",
  "tasks": [
    "asr"
  ],
  "modes": [
    "offline"
  ],
  "languages": [
    "bn"
  ],
  "capabilities": {
    "asr": [
      "word_timestamps"
    ]
  },
  "dependencies": [],
  "options": {
    "request": [
      {
        "name": "return_timestamps",
        "type": "bool",
        "description": "Return word timestamps derived from decoder token emission frames.",
        "required": false,
        "default": false
      },
      {
        "name": "audio_chunk_mode",
        "type": "enum",
        "description": "Long-form audio chunking mode.",
        "values": [
          "auto",
          "fixed",
          "quiet_energy",
          "vad",
          "none"
        ],
        "required": false,
        "default": "auto"
      },
      {
        "name": "audio_chunk_duration_sec",
        "type": "float",
        "description": "Maximum duration of each audio chunk in seconds.",
        "required": false,
        "min": 0.02,
        "max": 25,
        "default": 25
      }
    ],
    "session": [
      {
        "name": "vad_model_path",
        "type": "path",
        "description": "Offline VAD model used only with audio_chunk_mode=vad.",
        "required": false,
        "default": ""
      },
      {
        "name": "weight_type",
        "type": "enum",
        "description": "Weight storage type.",
        "preset": "weight_type_full",
        "required": false,
        "default": "native"
      }
    ],
    "load": []
  },
  "runtime": {
    "tags": [
      "gguf"
    ]
  },
  "ui": {
    "tags": [
      "ASR",
      "GGUF"
    ],
    "docs": [
      "nemo2gguf/conversion.md"
    ]
  },
  "packages": [],
  "sources": [
    {
      "format": "safetensors",
      "roots": {
        "model": "."
      },
      "files": {
        "config": "model:config.json"
      },
      "tensors": {
        "weights": "model:model.safetensors"
      }
    },
    {
      "format": "gguf",
      "roots": {
        "model": ".",
        "weights": "$gguf"
      },
      "files": {
        "config": "model:config.json"
      },
      "tensors": {
        "weights": "weights:"
      }
    }
  ]
}
